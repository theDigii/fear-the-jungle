# Newsletter (Buttondown). Without it the form succeeds but only logs the address.
BUTTONDOWN_API_KEY=

# Backend at /backend. All of these are required for it to work; the public
# site renders its built-in text without any of them.
DATABASE_URL=                      # Neon Postgres connection string (Vercel > Storage > Neon)
BLOB_READ_WRITE_TOKEN=             # Vercel Blob store token (Vercel > Storage > Blob)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # Clerk project > API keys
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/backend/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/backend
